# AIxWord Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# OpenAI Configuration (REQUIRED)
# ============================================================================

# Your OpenAI API key - Get it from https://platform.openai.com/api-keys
# This is REQUIRED for the application to work
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use for puzzle generation
# Options: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
# Recommended: gpt-4-turbo-preview for best results
OPENAI_MODEL=gpt-4-turbo-preview

# Temperature for LLM responses (0.0 = deterministic, 2.0 = very creative)
# Range: 0.0 to 2.0
# Recommended: 0.7 for balanced creativity and consistency
OPENAI_TEMPERATURE=0.7

# ============================================================================
# Grid Configuration
# ============================================================================

# Default crossword grid size (NxN)
# Range: 4 to 20
# Default: 8 (for 8x8 grid as per assignment)
GRID_SIZE=8

# Maximum iterations for puzzle generation workflow
# Higher values allow more attempts but take longer
# Range: 1 to 200
# Default: 50
MAX_ITERATIONS=50

# Minimum fill rate for a valid puzzle (percentage of grid filled)
# Range: 0.0 to 1.0 (0.6 = 60% filled)
# Default: 0.6
MIN_FILL_RATE=0.6

# ============================================================================
# API Configuration
# ============================================================================

# Host address for the API server
# Use 0.0.0.0 to accept connections from any IP (for Docker/production)
# Use 127.0.0.1 for localhost only (more secure for development)
API_HOST=0.0.0.0

# Port number for the API server
# Default: 8000
# Range: 1 to 65535
API_PORT=8000

# Enable API documentation endpoints (/docs and /redoc)
# Set to false in production if you want to hide API docs
# Default: true
ENABLE_DOCS=true

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed CORS origins
# Add your frontend URL(s) here
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Logging Configuration
# ============================================================================

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# Use DEBUG for development, INFO or WARNING for production
LOG_LEVEL=INFO

# ============================================================================
# Development vs Production
# ============================================================================

# For development, use these settings:
# - API_HOST=0.0.0.0 (or 127.0.0.1 for localhost only)
# - API_PORT=8000
# - LOG_LEVEL=DEBUG
# - ENABLE_DOCS=true
# - CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# For production, consider:
# - API_HOST=0.0.0.0
# - API_PORT=8000 (or use reverse proxy)
# - LOG_LEVEL=WARNING
# - ENABLE_DOCS=false (or true if you want public API docs)
# - CORS_ORIGINS=https://yourdomain.com

# ============================================================================
# Notes
# ============================================================================

# 1. NEVER commit the .env file to version control
# 2. Keep your OPENAI_API_KEY secret and secure
# 3. Use different API keys for development and production
# 4. Monitor your OpenAI API usage to avoid unexpected costs
# 5. The application will fail to start without a valid OPENAI_API_KEY
# 6. All other settings have sensible defaults and are optional

# ============================================================================
# Quick Start
# ============================================================================

# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your OPENAI_API_KEY
# 3. Optionally adjust other settings
# 4. Start the server: python run_server.py
# 5. Visit http://localhost:8000/docs to see API documentation

# ============================================================================
# Troubleshooting
# ============================================================================

# If the server won't start:
# - Check that OPENAI_API_KEY is set and valid
# - Verify the port is not already in use
# - Check Python version is 3.11+
# - Ensure all dependencies are installed: pip install -e .

# If puzzle generation fails:
# - Verify your OpenAI API key has sufficient credits
# - Check the OpenAI API status: https://status.openai.com/
# - Try a simpler topic or fewer words
# - Check the logs for detailed error messages

# For more help, see:
# - README.md for setup instructions
# - docs/DEPLOYMENT.md for deployment guide
# - docs/QUICK_START_GUIDE.md for quick start
