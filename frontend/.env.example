# AIxWord Frontend - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Backend API Configuration
# ============================================================================

# Base URL for the backend API
# This is where the frontend will send API requests
# 
# For development (default):
VITE_API_BASE_URL=http://localhost:8000

# For production, change to your actual backend URL:
# VITE_API_BASE_URL=https://api.yourdomain.com

# ============================================================================
# Application Configuration
# ============================================================================

# Application title (optional)
# VITE_APP_TITLE=AIxWord

# Application version (optional)
# VITE_APP_VERSION=1.0.0

# Enable debug mode (optional)
# Set to true for additional console logging
# VITE_DEBUG=false

# ============================================================================
# Feature Flags (optional)
# ============================================================================

# Enable AI assistance features
# VITE_ENABLE_AI_ASSISTANCE=true

# Enable puzzle generation
# VITE_ENABLE_PUZZLE_GENERATION=true

# Enable manual solving
# VITE_ENABLE_MANUAL_SOLVING=true

# ============================================================================
# Development vs Production
# ============================================================================

# For development, use:
# VITE_API_BASE_URL=http://localhost:8000

# For production, use:
# VITE_API_BASE_URL=https://api.yourdomain.com
# or if backend is on same domain:
# VITE_API_BASE_URL=/api

# ============================================================================
# Notes
# ============================================================================

# 1. All Vite environment variables must start with VITE_
# 2. Changes to .env require restarting the dev server (npm run dev)
# 3. NEVER commit .env to version control
# 4. The backend URL must be accessible from the browser
# 5. CORS must be properly configured on the backend

# ============================================================================
# Quick Start
# ============================================================================

# 1. Copy this file: cp .env.example .env
# 2. Edit .env if you need to change the backend URL
# 3. Start the dev server: npm run dev
# 4. Visit http://localhost:5173 in your browser

# ============================================================================
# Troubleshooting
# ============================================================================

# If API requests fail:
# - Check that the backend is running at the specified URL
# - Verify CORS is configured correctly on the backend
# - Check browser console for error messages
# - Ensure the backend URL is accessible from your browser

# If changes don't take effect:
# - Restart the dev server (Ctrl+C, then npm run dev)
# - Clear browser cache
# - Check that variable names start with VITE_

# For more help, see:
# - README.md for setup instructions
# - docs/FRONTEND.md for frontend documentation
# - docs/QUICK_START_GUIDE.md for quick start
